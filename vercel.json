{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/sources/paywall.js": {
      "memory": 3008,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/settings", "dest": "/settings.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
